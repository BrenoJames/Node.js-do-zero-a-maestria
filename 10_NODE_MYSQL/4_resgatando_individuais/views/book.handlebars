<div id="book-page">
    <a href="/books">Voltar para a lista</a>
    <div class="container">
        <!-- Exibe o título do livro -->
        <h1>Livro: {{book.title}}</h1> 
        
        <!-- Exibe a quantidade de páginas -->
        <p>Este livro tem <strong>{{book.pageqty}}</strong> páginas.</p>
        
        <!-- Opcional: mostrar o ID -->
        <span>Código do registro: #{{book.id}}</span>
    </div>
</div>

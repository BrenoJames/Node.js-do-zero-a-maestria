<h1>Cadastre o seu livro:</h1>
<form action="/books/insertbook" method="POST" class="form"> 
<div class="form-contrl">
    <label for="title">Titulo:</label>
    <input type="text" name="tittle" placeholder="Digite o titulo">
</div>

<div class="form-contrl">
    <label for="pageqty">Numero de paginas:</label>
    <input type="number" name="pageqty" placeholder="Quantas paginas o livro tem?">
</div>
<input type="submit" value="Cadastrar">
</form>